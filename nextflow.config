// Author: Naveen Duhan
// SPDX-License-Identifier: MIT
// Description: Default Nextflow pipeline manifest, parameter values, process directives, and execution profiles for local, SLURM, SDSU HPC, Conda, Mamba, Docker, Singularity, and Apptainer runs.

manifest {
    name = 'navduhan/metanextviro'
    author = 'Naveen Duhan'
    homePage = 'https://github.com/navduhan/metanextviro'
    description = 'High-Throughput Virus Identification, Novel Virus Discovery, and Metagenomic Analysis Pipeline'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    nextflowVersion = '>=22.10.0'
    version = '1.0.0'
}

params {
    max_cores = Runtime.runtime.availableProcessors()
    max_forks = 10
    cores = Runtime.runtime.availableProcessors().intdiv(4)
    memory = '12'
    outdir = 'results'
    // Publish portable files; keep hard links available as an opt-in mode.
    publish_mode = 'copy'
    blast_max_target_seqs = 50
    help = false
    profile = 'local'
    queue = null // SLURM partition/queue; defaults to 'compute' in slurm/sdsu profiles when null
    account = null // SLURM account to charge; set at runtime with --account
    container_image = 'ghcr.io/navduhan/metanextviro:latest'

    // Portable database & Conda cache management (override via --db_dir, --conda_cache_dir, or -profile sdsu)
    db_dir = "${System.getProperty('user.home')}/.metanextviro/dbs"
    conda_cache_dir = "${System.getProperty('user.home')}/.metanextviro/conda_envs"
    setup_databases = false
    auto_download_dbs = false
    db_preset = 'full_viral' // Options: 'full_viral' (~4 GB, default), 'minimal' (~1.1 GB), 'discovery_only' (~375 MB), 'genbank_complete' (~18-20 GB)
    db_components = null
    db_force = false

    // Samplesheet generation & direct FASTQ folder execution
    input = null
    create_samplesheet = false
    reads_dir = null
    fastq_dir = null
    samplesheet = 'samplesheet.csv'
    recursive_reads = false

    taxonomy_db = null // Explicit SQLite path; null resolves from --db_dir or ~/.etetoolkit/taxa.sqlite
    adapters = "${projectDir}/assets/illumina_adapter.fa"
    trimming_tool = 'trim_galore' // Options: 'fastp', 'flexbar', 'trim_galore'
    quality = '30'
    kraken2_db = null // Explicit Kraken2 DB; null resolves from ${params.db_dir}/kraken2_viral
    min_contig_length = 200
    assembler = 'megahit' // Options: 'metaspades', 'megahit', 'hybrid'

    // Search viral database by default; use --blast_options all for all databases.
    blast_options = ['viruses'] // Options: 'all', 'viruses' (alias: 'nt_viruses'), 'nt', 'nr'
    blastdb_viruses = null // Explicit BLAST viral DB; null resolves from ${params.db_dir}
    blastdb_nt = null
    blastdb_nr = null
    diamonddb = null
    blastx_tool = 'diamond' // Options: 'diamond', 'blastx' - DIAMOND is much faster

    // CheckV database path (resolved from --checkv_db or ${params.db_dir}/checkv)
    checkv_db = null

    // Optional steps run only when explicitly enabled via CLI flags.
    run_checkv = false
    run_virfinder = false
    run_genomad = false
    organize_contigs = false

    // Opt-in host depletion (pre-assembly)
    deplete_host = false
    host_fasta = null
    host_bowtie2_index = null

    // Opt-in automated novel virus detection (skips confident BLAST hits automatically)
    discover_novel_viruses = false
    discovery_all_contigs = false
    novel_min_contig_length = 500
    novel_min_orf_aa = 60
    known_virus_identity = 80.0
    known_virus_coverage = 50.0

    // Enhanced VirFinder thresholds & automatic Order/Family taxonomic assignment
    virfinder_min_score = 0.9
    virfinder_moderate_score = 0.7
    virfinder_max_qvalue = 0.05
    annotate_virfinder_taxonomy = true

    // Optional external databases for novel virus discovery & VirFinder taxonomy (resolved from --db_dir when null)
    genomad_db = null
    run_viral_hmm = false
    viral_hmm_db = null
    viral_hmm_taxonomy = null
    hmm_evalue = '1e-5'
    run_viral_protein_blast = false
    viral_protein_db = null
    viral_protein_evalue = '1e-4'
    run_foldseek = false
    foldseek_db = null
    foldseek_prostt5_weights = null
    foldseek_evalue = '1e-3'
    run_novel_phylogeny = false
    phylo_reference_faa = null
    phylo_tool = 'fasttree' // Options: 'fasttree', 'iqtree'

    // Skip options
    skip_quality = false
    skip_trimming = false
    skip_host_depletion = false
    skip_assembly = false
    skip_blast_annotation = false
    skip_taxonomic_profiling = false
    skip_viral_analysis = false
    skip_novel_detection = false
    skip_coverage_analysis = false
    skip_contig_organization = false
    skip_visualization = false
    skip_final_report = false
    skip_report = false
}

// Keep task history and restart capability. Raw reads are staged as links.
cleanup = false
trace.overwrite = true
report.overwrite = true
timeline.overwrite = true

// Default configuration (applies to all profiles)
process {
    stageInMode = 'symlink'
    errorStrategy = { task ->
        if (task && task.attempt < 3) {
            'retry'
        } else {
            'terminate'
        }
    }
    maxForks = params.max_forks
}

profiles {
    local {
        process.executor = 'local'
        executor {
            name = 'local'
            cpus = params.max_cores
        }
        includeConfig 'nextflow/configs/local.config'
    }

    slurm {
        process.executor = 'slurm'
        executor {
            name = 'slurm'
            queueSize = 100
        }
        process {
            queue = params.queue ?: 'compute'
            clusterOptions = { params.account ? "--account=${params.account}" : null }
        }
        includeConfig 'nextflow/configs/slurm.config'
    }

    // Institutional profile preserving SDSU cluster reference database paths + SLURM settings
    sdsu {
        params.kraken2_db = '/mmfs1/scratch/jacks.local/naveen.duhan/reference_datbases/kraken2_db'
        params.blastdb_viruses = '/mmfs1/scratch/jacks.local/naveen.duhan/reference_datbases/ncbi_dbs/nt_viruses/nt_viruses'
        params.blastdb_nt = '/mmfs1/scratch/jacks.local/naveen.duhan/reference_datbases/ncbi_dbs/nt/nt'
        params.blastdb_nr = '/mmfs1/scratch/jacks.local/naveen.duhan/reference_datbases/ncbi_dbs/nr/nr'
        params.diamonddb = '/mmfs1/scratch/jacks.local/naveen.duhan/reference_datbases/diamond_db/nr.dmnd'
        params.checkv_db = '/mmfs1/scratch/jacks.local/naveen.duhan/reference_datbases/checkvdb'
        process.executor = 'slurm'
        executor {
            name = 'slurm'
            queueSize = 100
        }
        process {
            queue = params.queue ?: 'compute'
            clusterOptions = { params.account ? "--account=${params.account}" : null }
        }
        includeConfig 'nextflow/configs/slurm.config'
    }

    conda {
        conda.enabled = true
        conda.cacheDir = params.conda_cache_dir
    }

    mamba {
        conda.enabled = true
        conda.useMamba = true
        conda.cacheDir = params.conda_cache_dir
    }

    docker {
        docker.enabled = true
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}:ro"
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "-B ${projectDir}:${projectDir}:ro"
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = "-B ${projectDir}:${projectDir}:ro"
    }
}
