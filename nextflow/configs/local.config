// SPDX-License-Identifier: MIT
// Description: Defines CPU and memory resource allocations for low, medium, high, and vhigh process labels when executing MetaNextViro on a local workstation, clamped safely to available host cores.

process.executor = 'local'

process {
    withLabel: 'low' {
        cpus = Math.max(1, Math.min(2, params.max_cores as int))
        memory = '2 GB'
    }

    withLabel: 'medium' {
        cpus = Math.max(1, Math.min(4, params.max_cores as int))
        memory = '8 GB'
    }

    withLabel: 'high' {
        cpus = Math.max(1, Math.min(8, params.max_cores as int))
        memory = '12 GB'
    }

    withLabel: 'vhigh' {
        cpus = Math.max(1, Math.min(12, params.max_cores as int))
        memory = '16 GB'
    }
}
