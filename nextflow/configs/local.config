// Description: Defines CPU and memory resource allocations for low, medium, high, and vhigh process labels when executing MetaNextViro on a local workstation.

process.executor = "local"

process {

    withLabel: 'low'  {
        cpus = 4
        memory = '2 GB'
    }

        withLabel: 'medium'  {
        cpus = 8
        memory = '10 GB'
    }

        withLabel: 'high'  {
        cpus = 12
        memory = '20 GB'
    }

        withLabel: 'vhigh'  {
        cpus = 40
        memory = '40 GB'
    }
}